{
  "manifest_version": 3,
  "name": "X 이미지 저장",
  "version": "0.1.2",
  "description": "X 게시물의 정적 이미지를 한 장 또는 전체 저장합니다. 폴더·파일명·원본 크기를 설정할 수 있습니다.",
  "minimum_chrome_version": "123",
  "permissions": ["downloads", "storage"],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "X 이미지 저장 설정",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "assets/icons/16.png", "32": "assets/icons/32.png" }
  },
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "content_scripts": [{
    "matches": ["https://x.com/*"],
    "js": ["content/index.js"],
    "css": ["content/content.css"],
    "run_at": "document_idle"
  }]
}
